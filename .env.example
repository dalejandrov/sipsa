# SIPSA Application Environment Variables — REFERENCE TEMPLATE
#
# This file is versioned documentation only: it lists every environment
# variable the application understands, with its default value. It is never
# read at runtime and no .env file is used by this project. Provide values
# through real environment variables (shell export, docker-compose
# `environment:`, or your deployment platform).
#
# Note: values fixed by the DANE contract (timezone, SOAP namespace, ingestion
# windows, cron schedule, pagination policy) are no longer environment
# variables — they live directly in src/main/resources/application.yaml.
# Exception: the monthly window START accepts an operational override
# (INGESTION_MONTHLY_WINDOW_START, TECH-133) with the contractual 14:00 as
# its canonical default.
# Local development defaults (credentials, verbose logging) live in
# src/main/resources/application-dev.yaml (profile "dev").

# Server Configuration
PORT=8080

# Spring Profiles ("dev" is the default when unset; use e.g. "prod" in production)
SPRING_PROFILES_ACTIVE=dev

# Security — OAuth 2.0 Resource Server (ADR-002)
# REQUIRED outside dev/docker-compose (the application fails fast without it).
# Not a secret: it is the OIDC issuer whose public JWKS signs the access tokens.
#   dev profile default:    http://localhost:9000/default  (local mock OIDC)
#   docker-compose default: http://oidc:9000/default       (compose mock service)
#   AWS:                    https://cognito-idp.<region>.amazonaws.com/<userPoolId>
SIPSA_JWT_ISSUER_URI=http://localhost:9000/default
# Optional defense-in-depth allowlist: CSV of Cognito app client ids allowed to
# call this API. Empty = any client of the trusted issuer. Client ids are
# identifiers, not secrets, but real values still belong in the environment.
SIPSA_JWT_ALLOWED_CLIENT_IDS=

# Database Configuration
# In non-dev profiles DB_USERNAME and DB_PASSWORD are REQUIRED (no defaults).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sipsa_db
DB_USERNAME=sipsa_user
DB_PASSWORD=sipsa_pass
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
DB_IDLE_TIMEOUT=30000

# SOAP Service Configuration (TECH-070: SoapProperties validates all of these
# at startup — endpoint non-blank, timeouts > 0, retry/limit counters >= 0).
# Endpoint stays overridable to point at a mock during testing.
#
# SOAP_ENDPOINT           non-blank URL — the client is always constructed,
#                         there is no "SOAP disabled" mode
# SOAP_CONNECT_TIMEOUT_MS integer > 0, unit: milliseconds
# SOAP_READ_TIMEOUT_MS    integer > 0, unit: milliseconds (kept high: Parcial
#                         alone is 619K+ records per full ingestion)
# SOAP_MAX_RETRIES        integer >= 0 (0 = no retries)
# SOAP_RETRY_BACKOFF_MS   integer >= 0, unit: milliseconds (0 = no backoff)
# SOAP_MAX_CHILD_ELEMENTS integer >= 0 — 0 means UNLIMITED (not "disabled");
#                         guards against XML-bomb-style responses otherwise
SOAP_ENDPOINT=https://appweb.dane.gov.co/sipsaWS/SrvSipsaUpraBeanService
SOAP_CONNECT_TIMEOUT_MS=30000
SOAP_READ_TIMEOUT_MS=3600000
SOAP_MAX_RETRIES=3
SOAP_RETRY_BACKOFF_MS=2000
SOAP_MAX_CHILD_ELEMENTS=0
SOAP_LOGGING_ENABLED=false

# Ingestion Tuning
#
# INGESTION_BATCH_SIZE -> sipsa.ingestion.batch-size (IngestionProperties).
# Constraint: positive integer, 1..10000 — invalid values abort startup.
# Canonical default 500, validated with the full DANE dataset (676,210 records,
# TECH-011 evidence). Changing it affects the number of batches per run, memory
# use, the size of the per-batch dedup IN queries, and ingestion duration.
# Larger values are NOT automatically better.
INGESTION_BATCH_SIZE=500
#
# INGESTION_MONTHLY_WINDOW_START -> sipsa.ingestion.monthly-window-start
# (IngestionProperties). Format: HH:mm; invalid values abort startup. Canonical
# default 14:00 (America/Bogota, the fixed sipsa.timezone per ADR-008) — kept
# for operational compatibility: it is the value application.yaml always made
# effective, aligned with DANE's ~14:00 COT publication; it is NOT a separately
# confirmed business decision. This is the AUTHORIZATION gate for monthly runs
# on their publication/grace day (MesMadr: 8/9, Abas: 10/11) — the monthly
# crons themselves fire at 14:30. An empty value behaves as unset (default
# applies). Precedence: env var > property > canonical default.
INGESTION_MONTHLY_WINDOW_START=14:00
#
# MAX_REJECT_COUNT -> sipsa.ingestion.max-reject-count (IngestionProperties,
# TECH-135). Constraint: integer >= 0 — invalid values abort startup.
# MAX_REJECT_RATE  -> sipsa.ingestion.max-reject-rate (IngestionProperties,
# TECH-135). Constraint: fraction in [0..1] (0.01 = 1%), NOT a percentage —
# invalid values abort startup.
# Quality gates evaluated ONCE at the end of each ingestion run over its final
# totals: the run is marked FAILED when rejects strictly exceed EITHER the
# absolute count OR the rate (OR semantics). The rate check only applies when
# the run saw at least one record (seen=0 -> only the count gate applies).
# Precedence: env var > property > canonical default (5000 / 0.01).
MAX_REJECT_COUNT=5000
MAX_REJECT_RATE=0.01

# Task Scheduling
TASK_POOL_SIZE=5
SIPSA_SCHEDULING_POOL_SIZE=5
SIPSA_SCHEDULING_AWAIT_TERMINATION=30

# Async Executor (TECH-136)
#
# Geometry of ingestionTaskExecutor (AsyncExecutorProperties ->
# sipsa.ingestion.async.*) — the managed ThreadPoolTaskExecutor that EVERY
# @Async method runs on, audit trail included (thread prefix
# "ingestion-async-"). Precedence: env var > property > canonical default.
# Invalid values abort startup naming the property.
#
# SIPSA_ASYNC_CORE_POOL_SIZE     integer >= 1 (default 2)
# SIPSA_ASYNC_MAX_POOL_SIZE      integer >= 1 AND >= core (default 10);
#                                max < core aborts startup
# SIPSA_ASYNC_QUEUE_CAPACITY     integer >= 0 (default 25); 0 = direct handoff,
#                                no intermediate queue — a submission either
#                                takes a thread or falls to the rejection
#                                policy (CallerRunsPolicy: the caller runs the
#                                task; backpressure, never a silent drop)
# SIPSA_ASYNC_KEEP_ALIVE_SECONDS integer >= 0, unit: seconds (default 60);
#                                applies to core threads too
SIPSA_ASYNC_CORE_POOL_SIZE=2
SIPSA_ASYNC_MAX_POOL_SIZE=10
SIPSA_ASYNC_QUEUE_CAPACITY=25
SIPSA_ASYNC_KEEP_ALIVE_SECONDS=60

# Health Indicator Staleness Thresholds (TECH-031)
#
# Maximum age of the last successful run of a monitored SOAP method
# (SipsaHealthProperties -> sipsa.health.*) before SipsaHealthIndicator
# reports it DOWN via /actuator/health. Precedence: env var > property >
# canonical default. Must be a positive duration (e.g. "36h", "35d");
# zero or negative values abort startup.
#
# SIPSA_HEALTH_DAILY_STALENESS_THRESHOLD   duration, default 36h — applies to
#                                           SipsaHealthIndicator.DAILY_METHODS
#                                           (24h daily cadence + 12h buffer)
# SIPSA_HEALTH_MONTHLY_STALENESS_THRESHOLD duration, default 840h (35 days) —
#                                           applies to every other monitored
#                                           method
SIPSA_HEALTH_DAILY_STALENESS_THRESHOLD=36h
SIPSA_HEALTH_MONTHLY_STALENESS_THRESHOLD=840h

# Logging Levels
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_SIPSA=INFO
