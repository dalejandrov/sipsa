@startuml Class Diagram
title SIPSA Class Diagram

package "API Layer" #E3F2FD {
  class SipsaRestController {
    + SipsaReadService readService
    + getCiudad(CiudadQueryRequest): ResponseEntity<ApiResponse<SipsaCiudadResponse>>
    + getMayoristasMensual(MayoristasMensualQueryRequest): ResponseEntity<ApiResponse<SipsaMayoristasMensualResponse>>
    + getParcial(ParcialQueryRequest): ResponseEntity<ApiResponse<SipsaParcialResponse>>
    + getMayoristasSemanal(MayoristasSemanalQueryRequest): ResponseEntity<ApiResponse<SipsaMayoristasSemanalResponse>>
    + getAbastecimientosMensual(AbastecimientosMensualQueryRequest): ResponseEntity<ApiResponse<SipsaAbastecimientosMensualResponse>>
  }

  class SipsaOpsController {
    + IngestionTriggerService triggerService
    + IngestionControlService controlService
    + IngestionRunQueryService runQueryService
    + triggerIngestion(String method, boolean force): ResponseEntity<IngestionTriggerResponse>
    + getAvailableMethods(): ResponseEntity<IngestionMethodsResponse>
    + cancelRun(Long runId): ResponseEntity<IngestionCancelResponse>
  }

  class GlobalExceptionHandler {
    + handleValidationException(ValidationException): ResponseEntity<ErrorResponse>
    + handleBusinessException(SipsaBusinessException): ResponseEntity<ErrorResponse>
    + handleExternalException(SipsaExternalException): ResponseEntity<ErrorResponse>
  }
}

package "Application Layer" #F3E5F5 {
  class SipsaReadService {
    + getCiudad(CiudadQueryRequest): Page<SipsaCiudadResponse>
    + getParcial(ParcialQueryRequest): Page<SipsaParcialResponse>
    + getMayoristasMensual(MayoristasMensualQueryRequest): Page<SipsaMayoristasMensualResponse>
    + getMayoristasSemanal(MayoristasSemanalQueryRequest): Page<SipsaMayoristasSemanalResponse>
    + getAbastecimientosMensual(AbastecimientosMensualQueryRequest): Page<SipsaAbastecimientosMensualResponse>
  }

  class IngestionService {
    + Map<String, IngestionHandler> handlerMap
    + execute(String methodName, IngestionContext): void
    + isValidMethod(String methodName): boolean
    + getAvailableMethodNames(): Set<String>
  }

  class IngestionTriggerService {
    + triggerIngestion(IngestionTriggerRequest): IngestionTriggerResponse
  }

  class AsyncIngestionService {
    + triggerAsync(IngestionTriggerRequest): void
  }

  class IngestionControlService {
    + createRun(CreateRunRequest): long
    + updateStatus(long runId, IngestionRunStatus status): void
    + updateMetrics(long runId, int seen, int inserted, int updated, int rejected): void
    + isRunComplete(String methodName, String windowKey): boolean
  }

  class IngestionAuditService {
    + logEvent(AuditEventRequest): void
  }

  class IngestionRunQueryService {
    + getAvailableMethods(): IngestionMethodsResponse
    + getRuns(IngestionRunQueryRequest): Page<IngestionRunResponse>
  }
}

