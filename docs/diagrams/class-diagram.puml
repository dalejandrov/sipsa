package "Infrastructure Layer" #FFF3E0 {
  class GenericIngestionJob {
    - IngestionService ingestionService
    + execute(IngestionRequest): void
  }

  abstract class IngestionJob {
    # WindowPolicy windowPolicy
    # IngestionControlService controlService
    # IngestionAuditService auditService
    # double maxRejectRate
    # int maxRejectCount
    {abstract} + runIngestion(IngestionContext): void
    + execute(IngestionRequest): void
  }

  class WindowPolicy {
    - LocalTime dailyStart
    - LocalTime dailyEnd
    - Set<Integer> monthlyRunDays
    - LocalTime monthlyStart
    - ZoneId zone
    + validateAndGetKey(String methodName, boolean force): String
  }

  class IngestionContext {
    - long runId
    - String methodName
    - String windowKey
    - String requestId
    - RequestSource requestSource
    - int recordsSeen
    - int recordsInserted
    - int recordsUpdated
    - int rejectCount
    - List<RejectedRecord> rejectedRecords
  }

  interface IngestionHandler {
    + getMethodName(): String
    + execute(IngestionContext): void
  }

  class CiudadIngestionHandler {
    + getMethodName(): String
    + execute(IngestionContext): void
  }

  class ParcialIngestionHandler {
    + getMethodName(): String
    + execute(IngestionContext): void
  }

  class MesIngestionHandler {
    + getMethodName(): String
    + execute(IngestionContext): void
  }

  class SemanaIngestionHandler {
    + getMethodName(): String
    + execute(IngestionContext): void
  }

  class AbasIngestionHandler {
    + getMethodName(): String
    + execute(IngestionContext): void
  }

  class SipsaIngestionScheduler {
    - GenericIngestionJob ingestionJob
    + runDailyWindow(): void
    + runMonthlyMes(): void
    + runMonthlyAbas(): void
  }

  class TimezoneFilter {
    + doFilterInternal(HttpServletRequest, HttpServletResponse, FilterChain): void
  }

  class RequestContextFilter {
    + doFilterInternal(HttpServletRequest, HttpServletResponse, FilterChain): void
  }
}

